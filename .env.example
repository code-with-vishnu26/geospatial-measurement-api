# Copy to .env and adjust. Every setting is optional; defaults are shown.

GEO_ENVIRONMENT=development
GEO_LOG_LEVEL=INFO

# Uploads and the SQLite database live here.
GEO_DATA_DIR=data
# Any SQLAlchemy URL; defaults to sqlite:///<GEO_DATA_DIR>/app.db
# GEO_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/geo

# Upload / archive limits (bytes unless stated)
GEO_MAX_UPLOAD_BYTES=52428800
GEO_MAX_ARCHIVE_MEMBERS=100
GEO_MAX_EXTRACTED_BYTES=262144000
GEO_MAX_COMPRESSION_RATIO=200
GEO_MAX_FEATURES=100000

# Largest tolerated scale error (0.005 = 0.5%) of a projection used for measurement.
GEO_MAX_SCALE_DISTORTION=0.005
