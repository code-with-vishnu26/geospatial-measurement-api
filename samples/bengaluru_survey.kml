          <Data name="category"><value>botanical garden</value></Data>
          <Data name="surveyed_by"><value>Team A</value></Data>
        </ExtendedData>
        <Polygon><outerBoundaryIs><LinearRing><coordinates>77.58,12.953 77.589,12.953 77.5905,12.948 77.585,12.9445 77.5795,12.9475 77.58,12.953</coordinates></LinearRing></outerBoundaryIs></Polygon>
      </Placemark>
